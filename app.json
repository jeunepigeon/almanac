{
  "expo": {
    "name": "Almanac",
    "slug": "almanac",
    "version": "1.28",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E0E"
    },
    "plugins": [
      "./plugins/with-adi-registration.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7A7A7A"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Almanac utilise Face ID pour déverrouiller l'app."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jeunepigeon.almanac"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E0E"
      },
      "package": "com.jeunepigeon.almanac",
      "versionCode": 141
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0fa615d9-f762-48d6-95ac-1201c1284b9e"
      }
    }
  }
}